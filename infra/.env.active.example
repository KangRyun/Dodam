# 도담 — 블루-그린 활성 색 상태 파일 **템플릿**  (실파일: infra/.env.active)
#
# 이 파일은 "지금 어느 색이 활성인가 / 그 색이 어떤 태그로 떠 있는가"를 담는 **운영 상태**다.
# bluegreen-deploy.sh 가 배포/롤백 때마다 다시 쓴다. 사람이 읽고 최초 컷오버 때 한 번 만든다.
#   · 시크릿 없음(색·태그·profile 목록뿐) — 그래도 상태 파일이므로 .env.compose 와 함께
#     git 비추적으로 둔다(운영 서버의 실체가 진실. 저장소에 박제하지 않는다).
#
# 사용:
#   docker compose -f infra/docker-compose.yml \
#     --env-file infra/.env.compose --env-file infra/.env.active up -d
#   → 데이터 계층 + nginx + **COMPOSE_PROFILES 에 적힌 활성 색만** 뜬다(유휴 색은 안 뜬다).
#
# 최초 컷오버(레거시→blue) 절차는 bluegreen-deploy.sh 헤더의 ★★ 절 참조.
# 아래는 "활성 색 = 모두 blue, 현재 운영 태그 0d62bd59" 초기값 예시다.

# 각 서비스의 현재 활성 색 (blue|green) — bluegreen-deploy.sh 가 갱신
ACTIVE_BACKEND=blue
ACTIVE_AI=blue
ACTIVE_WEB=blue

# 활성 색 profile 목록 — 기본 up -d 가 이 색만 띄운다(ACTIVE_* 와 반드시 일치).
#   bluegreen-deploy.sh 가 ACTIVE_* 로부터 재계산해 덮어쓴다.
COMPOSE_PROFILES=backend-blue,ai-blue,web-blue

# 각 (서비스,색) 이 마지막에 뜬 이미지 태그 — 재부팅 시 활성 색이 옳은 태그로 복원되게 한다.
#   미설정이면 compose 가 ${IMAGE_TAG}(infra/.env.compose) 로 폴백한다.
#   배포 스크립트가 유휴 색을 새 태그로 올릴 때 그 색의 값을 여기에 기록한다.
IMAGE_TAG_BACKEND_BLUE=0d62bd59
IMAGE_TAG_AI_BLUE=0d62bd59
IMAGE_TAG_WEB_BLUE=0d62bd59
# IMAGE_TAG_BACKEND_GREEN=   # 첫 green 배포 때 스크립트가 채운다
# IMAGE_TAG_AI_GREEN=
# IMAGE_TAG_WEB_GREEN=
