# 도담(dodam) — 컷백(k3s → docker-compose) 환경파일 **예제 템플릿**
#
# ★ 실제 파일은 `infra/.env.compose`(git 비추적, 권한 600). 이 예제는 그 파일이 요구하는
#   키를 **서비스(소비자)별 9섹션**으로 정리한 것 — 시크릿 값은 전부 비워 두었다(커밋 안전).
# ★ 이 한 파일에 backend·ai·web 3개 앱 + 데이터 컨테이너 4종 + compose 인프라가 쓰는 값이
#   전부 모여 있다(k8s 시절엔 ConfigMap·Secret 여러 개였던 것). 그래서 길다 — 버릴 키는 없다.
# ★ 각 섹션 헤더가 "누가 읽나"를 말해 준다. `=` 뒤가 빈 것이 채워야 할 시크릿이다.
#
# ⚠️ 안전을 위해 값 줄에는 인라인 주석(#)을 붙이지 않는다 — compose env-file 파서가 값 뒤
#   `#` 를 항상 벗기지 않아 주석이 값으로 샐 수 있다. 설명은 전부 별도 주석 줄에 둔다.
#
# 사용: 이 파일을 `.env.compose` 로 복사 → 빈 값을 Infra 에게 받아 채움(600 유지, 커밋 금지)
#      → docker compose -f infra/docker-compose.yml --env-file infra/.env.compose up -d
# <...> 플레이스홀더는 환경에 맞게 바꾼다.

# ══════════════════════════════════════════════════════════════════
# 1. compose 인프라 — compose 파일이 직접 치환/마운트 (앱이 읽는 값 아님)
# ══════════════════════════════════════════════════════════════════
# 앱 이미지 4종(backend·ai·web·nginx) 공통 태그. 배포마다 다르다.
IMAGE_TAG='<배포할-git-커밋-SHA>'
# 데이터 bind 마운트 루트(k3s local-path PVC 실체). root:root 700 이라 도커 데몬만 읽는다.
PVC_ROOT='/var/lib/rancher/k3s/storage'
# nginx conf 마운트. ★ bake 소스(conf.d)와 분리 — 라이브 이미지엔 /api/oauth/ 블록이 없다(817).
NGINX_CONF_DIR='<레포-절대경로>/infra/nginx/conf.d.compose'
MONGO_INITDB_DIR='<레포-절대경로>/infra/mongo/initdb'
# backend 에 FCM 키 파일을 마운트할 호스트 경로.
FCM_CREDENTIALS_HOST_PATH=
# 전 컨테이너 시간대.
TZ='Asia/Seoul'

# ══════════════════════════════════════════════════════════════════
# 2. MySQL — mysql 이미지가 초기화에 사용 + backend 가 접속
#    (ROOT_PASSWORD·PASSWORD = 시크릿 / USER·DATABASE·HOST·PORT = 구조값)
# ══════════════════════════════════════════════════════════════════
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE='b209'
MYSQL_USER='dodam'
MYSQL_PASSWORD=
DB_HOST='mysql'
DB_PORT='3306'

# ══════════════════════════════════════════════════════════════════
# 3. MongoDB — mongo 이미지 초기화 + backend
#    root=인증DB admin / 앱계정=인증DB dodam (0·2-4절 함정 주의)
# ══════════════════════════════════════════════════════════════════
MONGO_ROOT_USERNAME='dodam_root'
MONGO_ROOT_PASSWORD=
MONGO_DATABASE='dodam'
MONGO_APP_USERNAME='dodam_app'
MONGO_APP_PASSWORD=
MONGO_HOST='mongodb'
MONGO_PORT='27017'

# ══════════════════════════════════════════════════════════════════
# 4. Redis — redis 이미지 + backend (세션·리프레시 토큰 캐시)
# ══════════════════════════════════════════════════════════════════
REDIS_PASSWORD=
REDIS_HOST='redis'
REDIS_PORT='6379'

# ══════════════════════════════════════════════════════════════════
# 5. MinIO / 오브젝트 스토리지 — minio 이미지 + backend (그림·음성 파일)
#    STORAGE_MODE 가 s3 면 LOCAL_* 는 미사용(local 폴백용)
# ══════════════════════════════════════════════════════════════════
MINIO_ROOT_USER='dodam-root'
MINIO_ROOT_PASSWORD=
MINIO_BE_USER='dodam-be-rw'
MINIO_BE_PASSWORD=
STORAGE_MODE='s3'
S3_ENDPOINT='http://minio:9000'
S3_REGION='ap-northeast-2'
S3_BUCKET='dodam'
LOCAL_IMAGE_STORAGE_ROOT='/app/storage/images'
LOCAL_AUDIO_STORAGE_ROOT='/app/storage/audio'

# ══════════════════════════════════════════════════════════════════
# 6. backend 앱 — 인증·보안·푸시 (전부 backend 가 읽음)
# ══════════════════════════════════════════════════════════════════
SPRING_PROFILES_ACTIVE='local'
JWT_SECRET=
JWT_ISSUER='dodam-api'
# TTL 은 비우면 앱 기본값을 쓴다.
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=
OAUTH_CONNECT_TIMEOUT='3s'
OAUTH_READ_TIMEOUT='5s'
# ⚠️ 아래 둘은 바꾸면 기존 데이터가 즉시 무효(PIN 전원 초기화 · 기기토큰 복호화 불가). 운영값 그대로.
GUARDIAN_PIN_PEPPER=
PUSH_DEVICE_TOKEN_ENCRYPTION_KEY=
APP_PUSH_FCM_ENABLED='true'
# 컨테이너 내부 FCM 키 경로(위 1절 FCM_CREDENTIALS_HOST_PATH 가 여기로 마운트됨).
APP_PUSH_FCM_CREDENTIALS_PATH=

# ══════════════════════════════════════════════════════════════════
# 7. backend → ai 연동 — backend 가 ai 를 호출하는 라우팅/타임아웃
#    (AI_INTERNAL_TOKEN 만 시크릿, 나머지는 내부 주소·모드)
# ══════════════════════════════════════════════════════════════════
AI_BASE_URL='http://ai:8000'
AI_DRAWING_ANALYSIS_MODE='http'
AI_DRAWING_ANALYSIS_BASE_URL='http://ai:8000'
AI_OBSERVATION_MODE='http'
AI_OBSERVATION_BASE_URL='http://ai:8000'
# 리포트 read 타임아웃 — 990 에서 30s→60s 로 수동 patch 한 값.
AI_OBSERVATION_READ_TIMEOUT='60s'
AI_TTS_MODE='http'
AI_TTS_BASE_URL='http://ai:8000'
# ai 가 그림을 받으러 backend 로 오는 주소 + 1회용 토큰 TTL.
AI_IMAGE_ACCESS_BASE_URL='http://backend:8080'
AI_IMAGE_ACCESS_TOKEN_TTL=
# backend↔ai 공유 시크릿(헤더 X-Internal-Token). 양쪽 값이 같아야 한다.
AI_INTERNAL_TOKEN=

# ══════════════════════════════════════════════════════════════════
# 8. ai 서비스 — ai/config.py 가 읽음 (모델·외부 API)
# ══════════════════════════════════════════════════════════════════
LLM_MODEL='gpt-5.4-mini'
REPORT_LLM_MODEL='gpt-5.4'
STT_MODEL='whisper-1'
TTS_MODEL='gpt-4o-mini-tts'
TTS_VOICE='fable'
YOLO_MODEL_PATH='/models/htp_yolo/htp_best.pt'
SKETCH_MODEL_PATH='/models/htp_yolo/sketch_base.pt'
# GMS(OpenAI 호환 게이트웨이) API 키 + 엔드포인트.
GMS_KEY=
GMS_BASE_URL='https://gms.ssafy.io/gmsapi/api.openai.com/v1'

# ══════════════════════════════════════════════════════════════════
# 9. web (Next.js SSR) — 서버 라우트 + 소셜 로그인 토큰 교환
#    *_CLIENT_ID 는 공개값(클라이언트에 박힘) / *_CLIENT_SECRET 만 시크릿
# ══════════════════════════════════════════════════════════════════
WEB_API_BASE_URL='http://backend:8080/api/v1'
KAKAO_APP_ID='1398919'
GOOGLE_CLIENT_ID='376096475036-p3ql5nak2fn1tm4caevkl4h58nchbsjf.apps.googleusercontent.com'
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
