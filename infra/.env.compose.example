# 도담(dodam) — 컷백(k3s → docker-compose) 환경파일 **예제 템플릿**
#
# ★ 실제 파일은 `infra/.env.compose`(git 비추적, 권한 600)다. 이 예제는 그 파일이
#   어떤 키를 요구하는지 문서화한 것 — **시크릿 값은 전부 비워** 두었다(안전하게 커밋 가능).
#   값의 출처: 라이브 k3s ConfigMap dodam-config + Secret dodam-secrets 역이식(2026-08-07).
#   git 이 아니라 라이브가 기준인 이유는 `_workspace/cutback_infra_compose-plan.md` 참조.
#
# 사용:
#   1) 이 파일을 `infra/.env.compose` 로 복사
#   2) 빈 값(시크릿)을 Infra 에게 받아 채운다   ⚠️ 채운 파일은 커밋 금지(600 유지)
#   3) docker compose -f infra/docker-compose.yml --env-file infra/.env.compose up -d
#
# ⚠️ <...> 플레이스홀더는 환경에 맞게 바꾼다(레포 절대경로 · 배포 이미지 태그).
# ⚠️ 운영 중인 `infra/.env` 는 별개 파일이다(Jenkins web build-arg·과거 compose 용). 컷백은 이 파일.

# ── 컷백 전용: 이미지 태그 ─────────────────────────────────────────
# 라이브 배포 중인 앱 이미지 태그(backend·ai·web·nginx 공통 git SHA). 배포마다 다르다.
IMAGE_TAG='<배포할-git-커밋-SHA>'

# ── 컷백 전용: 호스트 경로 ─────────────────────────────────────────
# k3s local-path PVC 의 실체 디렉터리 루트. compose 가 이 아래를 bind 마운트한다.
#   ⚠️ root:root 700 이라 일반 사용자는 못 읽는다. 도커 데몬(root)이 마운트하므로 동작에는 문제없다.
PVC_ROOT='/var/lib/rancher/k3s/storage'
# 절대 호스트 경로만 쓴다 — 상대경로 + DooD 가 2026-07-22 빈 conf 사고의 원인이었다(641).
# ★ conf.d 가 아니라 conf.d.compose 다. 이미지 bake 소스(conf.d)와 분리한 이유는
#   그 파일 상단 주석 참조 — 라이브 이미지에 구워진 conf 에는 /api/oauth/ 블록이 없다(817).
NGINX_CONF_DIR='<레포-절대경로>/infra/nginx/conf.d.compose'
MONGO_INITDB_DIR='<레포-절대경로>/infra/mongo/initdb'
# web 의 서버-사이드 Route Handler 가 backend 를 부르는 내부 절대주소(k8s web.yaml 과 동일).
WEB_API_BASE_URL='http://backend:8080/api/v1'

# ── ConfigMap dodam-config (구조값 — 배포 공통, 시크릿 아님) ────────
TZ='Asia/Seoul'
SPRING_PROFILES_ACTIVE='local'
DB_HOST='mysql'
DB_PORT='3306'
REDIS_HOST='redis'
REDIS_PORT='6379'
MONGO_HOST='mongodb'
MONGO_PORT='27017'
AI_BASE_URL='http://ai:8000'
AI_DRAWING_ANALYSIS_MODE='http'
AI_DRAWING_ANALYSIS_BASE_URL='http://ai:8000'
AI_OBSERVATION_MODE='http'
AI_OBSERVATION_BASE_URL='http://ai:8000'
AI_OBSERVATION_READ_TIMEOUT='60s'
AI_TTS_MODE='http'
AI_TTS_BASE_URL='http://ai:8000'
AI_IMAGE_ACCESS_BASE_URL='http://backend:8080'
AI_IMAGE_ACCESS_TOKEN_TTL=
LLM_MODEL='gpt-5.4-mini'
REPORT_LLM_MODEL='gpt-5.4'
STT_MODEL='whisper-1'
TTS_MODEL='gpt-4o-mini-tts'
TTS_VOICE='fable'
YOLO_MODEL_PATH='/models/htp_yolo/htp_best.pt'
SKETCH_MODEL_PATH='/models/htp_yolo/sketch_base.pt'
STORAGE_MODE='s3'
S3_ENDPOINT='http://minio:9000'
S3_REGION='ap-northeast-2'
S3_BUCKET='dodam'
LOCAL_IMAGE_STORAGE_ROOT='/app/storage/images'
LOCAL_AUDIO_STORAGE_ROOT='/app/storage/audio'
JWT_ISSUER='dodam-api'
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=
OAUTH_CONNECT_TIMEOUT='3s'
OAUTH_READ_TIMEOUT='5s'
APP_PUSH_FCM_CREDENTIALS_PATH=

# ── Secret dodam-secrets (★ 값은 비어 있다 — Infra 에게 받아 채운다) ──
# ⚠️ GUARDIAN_PIN_PEPPER · PUSH_DEVICE_TOKEN_ENCRYPTION_KEY 는 바꾸면 기존 데이터가
#    즉시 무효가 된다(PIN 전원 초기화 · 기기 토큰 복호화 불가). 운영값을 그대로 받아 쓴다.
# 계정명(USER/USERNAME)·DB명은 시크릿이 아니라 그대로 두었다 — 비밀번호만 채우면 된다.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE='b209'
MYSQL_USER='dodam'
MYSQL_PASSWORD=
REDIS_PASSWORD=
MONGO_ROOT_USERNAME='dodam_root'
MONGO_ROOT_PASSWORD=
MONGO_DATABASE='dodam'
MONGO_APP_USERNAME='dodam_app'
MONGO_APP_PASSWORD=
MINIO_ROOT_USER='dodam-root'
MINIO_ROOT_PASSWORD=
MINIO_BE_USER='dodam-be-rw'
MINIO_BE_PASSWORD=
AI_INTERNAL_TOKEN=
JWT_SECRET=
GMS_KEY=
GMS_BASE_URL='https://gms.ssafy.io/gmsapi/api.openai.com/v1'
GUARDIAN_PIN_PEPPER=
PUSH_DEVICE_TOKEN_ENCRYPTION_KEY=
APP_PUSH_FCM_ENABLED='true'
FCM_CREDENTIALS_HOST_PATH=
# OAuth 클라이언트 ID 는 공개값(클라이언트에 박힘)이라 그대로 둔다. 시크릿은 아래 *_SECRET.
KAKAO_APP_ID='1398919'
GOOGLE_CLIENT_ID='376096475036-p3ql5nak2fn1tm4caevkl4h58nchbsjf.apps.googleusercontent.com'
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
