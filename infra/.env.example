# ─────────────────────────────────────────────────────────────────────────
# 도담 배포 환경변수 템플릿  (infra/.env.example)
#
# ★ 배포 정본(source of truth) = Jenkins Credential `dodam-env` (secret file).
#   파이프라인이 `docker compose --env-file <dodam-env> ...` 로 주입한다.
#   따라서 CI 배포에는 이 파일도, 디스크의 infra/.env 도 쓰이지 않는다.
#
# ★ 수동/판정 배포(exec/포팅매뉴얼.md)에서만 디스크 .env 를 쓴다:
#     cp infra/.env.example infra/.env      # 이 템플릿을 복사
#     # 아래 값을 실제 값으로 채운다
#     docker compose --env-file .env up -d
#
# ⚠️ .env 는 아래 '모든' 키를 포함해야 한다. 키가 빠지면 compose 기본값으로
#    폴백되어 프로덕션과 어긋난다. 특히:
#      - AI_OBSERVATION_MODE 누락 → 관찰 리포트가 mock 으로 생성됨(운영=http)
#      - PUSH_DEVICE_TOKEN_ENCRYPTION_KEY 누락 → 기기 토큰 등록 503
#    (2026-07-27: 디스크 .env 가 이 두 키를 포함해 16개가 빠져 있던 것을 발견)
#
# ⚠️ 실제 값이 담긴 .env 는 절대 커밋 금지(.gitignore 로 무시됨). 이 .env.example
#    (플레이스홀더)만 추적한다. 실제 비밀은 팀 vault + Jenkins dodam-env 에 보관.
#
# ⚠️ 주석 앞에는 반드시 '공백'만 쓴다 — 탭을 쓰면 주석이 값에 섞인다.
#    compose 의 dotenv 파서는 인라인 주석 구분자로 공백만 인식한다(v5.3.1 실측):
#      KEY=value  # 주석      → value        (정상)
#      KEY=value\t# 주석      → "value\t# 주석"  (주석이 값이 됨)
#    조용히 깨지므로 기동은 되고 동작만 어긋난다. 정렬한다고 탭을 넣지 말 것.
#
# ⚠️ 이 템플릿의 '비밀 아닌 기본값'도 환경마다 다를 수 있다. 복사 후 반드시
#    운영 중인 실제 값과 대조할 것 — 2026-07-28 사고: MYSQL_DATABASE 와
#    MINIO_BE_USER 가 템플릿 기본값으로 덮여 백엔드 크래시 + 파일 I/O 실패.
# ─────────────────────────────────────────────────────────────────────────

# ── [필수·비밀] 값이 없으면 compose 가 기동을 거부한다(:? 가드) ──────────────
JWT_SECRET=CHANGE_ME_base64_or_long_random          # 서비스 JWT 서명 키(장기 비밀)
REDIS_PASSWORD=CHANGE_ME                             # Redis 접속 비밀번호
AI_INTERNAL_TOKEN=CHANGE_ME                          # BE↔AI 내부 호출 인증 토큰

# ── [필수·비밀] MySQL (컨테이너 '최초' 기동 시에만 계정/DB 생성) ──────────────
# ⚠️ MYSQL_DATABASE/USER 는 데이터 볼륨이 비어 있을 때만 반영된다. 이미 초기화된
#    볼륨에서는 무시되므로, 기존 서버에 적용할 때는 반드시 실제 DB명과 맞출 것.
#    확인: docker exec dodam-mysql sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -e "SHOW DATABASES"'
#    (i15b209 운영 서버의 실제 DB 는 dodam 이 아니라 b209 다 — 2026-07-28 사고 원인)
#    DB_NAME 은 compose 가 MYSQL_DATABASE 에서 파생한다 → 틀리면 백엔드가 크래시 루프.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=dodam
MYSQL_USER=dodam
MYSQL_PASSWORD=CHANGE_ME
# BE 접속 계정은 위 MYSQL_USER/PASSWORD 와 동일 소스를 참조한다.

# ── [필수·비밀] MinIO 오브젝트 스토리지 ─────────────────────────────────────
# ⚠️ 사용자명은 minio-init 이 '최초 프로비저닝할 때 쓴 이름'과 일치해야 한다.
#    이미 프로비저닝된 서버에서 이름을 바꾸면 자격증명 불일치가 되는데,
#    백엔드는 기동 시 MinIO 를 호출하지 않으므로 healthy 로 뜨고 파일 저장·조회
#    시점에야 실패한다(조용한 장애). 확인: mc admin user list <alias>
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BE_USER=dodam-be-rw
MINIO_BE_PASSWORD=CHANGE_ME
MINIO_AI_USER=dodam-ai-ro
MINIO_AI_PASSWORD=CHANGE_ME

# ── [필수·비밀] AI(GMS · OpenAI 호환) ───────────────────────────────────────
GMS_BASE_URL=CHANGE_ME                               # GMS 엔드포인트(OpenAI 호환)
GMS_KEY=CHANGE_ME                                    # GMS 단일 API 키

# ── [운영 주의] 프로덕션에서 기본값과 달라야 하는 설정 ───────────────────────
AI_OBSERVATION_MODE=http                             # 기본 mock — 운영은 http(실동작)
PUSH_DEVICE_TOKEN_ENCRYPTION_KEY=CHANGE_ME_base64_32 # `openssl rand -base64 32`. 기본 빈값→등록 503
APP_PUSH_FCM_ENABLED=true                            # 기본 false — 푸시 발송하려면 true
FCM_CREDENTIALS_HOST_PATH=/etc/dodam/secrets/fcm-service-account.json  # 기본 /dev/null
GOOGLE_CLIENT_ID=                                    # 구글 로그인 검증용 Web Client ID
KAKAO_APP_ID=                                        # Kakao Token 검증용 App ID

# ── [설정] 기본값이 단일호스트 배포에 맞음 — 특별한 사유 없으면 그대로 ─────────
SPRING_PROFILES_ACTIVE=local
# 파일 저장 위치. local = 백엔드 컨테이너 볼륨, s3 = MinIO.
# i15b209 운영 서버는 2026-07-28 부로 s3 로 전환됐다(docs/인프라/minio-스토리지-컷오버.md).
# local 로 되돌리면 '전환 이후' 저장된 파일은 읽지 못한다 — 롤백 전 런북을 볼 것.
STORAGE_MODE=local
S3_ENDPOINT=http://minio:9000
S3_BUCKET=dodam
S3_REGION=ap-northeast-2
AI_BASE_URL=http://ai:8000
AI_DRAWING_ANALYSIS_BASE_URL=http://ai:8000
AI_DRAWING_ANALYSIS_MODE=mock                        # 실그림 분석 시 http (372 연계)
AI_OBSERVATION_BASE_URL=http://ai:8000
AI_IMAGE_ACCESS_BASE_URL=http://backend:8080
AI_IMAGE_ACCESS_TOKEN_TTL=60s
JWT_ISSUER=dodam-api
JWT_ACCESS_TOKEN_TTL=30m
JWT_REFRESH_TOKEN_TTL=14d
OAUTH_CONNECT_TIMEOUT=3s
OAUTH_READ_TIMEOUT=5s
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=fable
