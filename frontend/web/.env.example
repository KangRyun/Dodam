NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 소셜 로그인 Client ID (브라우저 노출 가능). 각 제공자 콘솔에서 발급.
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=

# 소셜 로그인 Client Secret (서버 전용, 브라우저에 노출 금지).
# code→token 교환은 서버 Route Handler(/api/oauth/[provider])에서만 사용한다.
# 카카오는 보안 설정에 따라 선택적일 수 있다.
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_SECRET=

# 각 제공자 콘솔에 등록할 리다이렉트 URI (참고):
#   {origin}/login/callback/kakao
#   {origin}/login/callback/google
#   {origin}/login/callback/naver
