# 빌드 컨텍스트(ai/)에서 이미지로 들어가면 안 되는 것들.
# 목적: 시크릿(.env) 유출 방지 + 캐시/산출물 제외로 이미지 청결·재현성.

# 시크릿 — 절대 이미지에 굽지 않는다(런타임에 compose가 주입).
.env
.env.*

# 파이썬 캐시/컴파일 산출물
__pycache__/
*.py[cod]
*$py.class

# 가상환경(있다면) — 이미지 안에서 pip로 새로 설치하므로 불필요
.venv/
venv/

# 테스트/스모크 산출물 (예: TTS out.mp3)
*.mp3
*.wav

# 린트/테스트 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
