# Copy this file to .env and fill in local values.
# Never commit the real .env file.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dodam
DB_USERNAME=root
DB_PASSWORD=

# MySQL container init (used by compose to bootstrap the mysql service)
# Keep in sync with the Database block above:
#   MYSQL_DATABASE = DB_NAME, MYSQL_USER = DB_USERNAME, MYSQL_PASSWORD = DB_PASSWORD
# MYSQL_ROOT_PASSWORD is admin-only and MUST differ from the app user's password.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Backend
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080

# 인증(JWT) — S15P11B209-320
# JWT_SECRET: 배포 필수 — compose가 ${JWT_SECRET:?}로 검증, 없으면 기동 자체가 실패(fail-fast).
#   32바이트 이상 필요. 생성 예: openssl rand -hex 32   (값은 .env/배포 시크릿에만 — 커밋 금지)
JWT_SECRET=
# 아래 3개는 선택 — 주석 그대로 두면 기본값(dodam-api / 30m / 14d) 적용.
# JWT_ISSUER=dodam-api
# JWT_ACCESS_TOKEN_TTL=30m
# JWT_REFRESH_TOKEN_TTL=14d

# OAuth Provider Token 검증 — S15P11B209-375
# KAKAO_APP_ID는 access_token_info 응답의 app_id와 비교한다.
# GOOGLE_CLIENT_ID는 Flutter Google 로그인 serverClientId와 동일한 Web Client ID여야 한다.
# 미설정 상태여도 배포는 가능하며 해당 Provider 로그인만 503(fail-closed)으로 막힌다.
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=
# OAuth 프로바이더 HTTP 타임아웃 — 선택(기본 3s / 5s)
# OAUTH_CONNECT_TIMEOUT=3s
# OAUTH_READ_TIMEOUT=5s

# Redis (Refresh Token 및 공유 멱등성 저장소)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Compose/운영 환경에서는 반드시 안전한 값으로 채운다.
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
# ⚠️ 아래 CONVERSATION_IDEMPOTENCY_* 5종은 compose 배포에선 컨테이너로 전달하지 않는다
#    (앱 기본값 사용 — 과잉 배선 방지). 로컬 단독 실행 시에만 참조됨.
CONVERSATION_IDEMPOTENCY_PROCESSING_TTL=30s
CONVERSATION_IDEMPOTENCY_COMPLETED_TTL=24h
CONVERSATION_IDEMPOTENCY_FAILURE_TTL=5m
CONVERSATION_IDEMPOTENCY_PROCESSING_WAIT=3s
CONVERSATION_IDEMPOTENCY_POLLING_INTERVAL=50ms

# Local image storage (development and first MVP)
LOCAL_IMAGE_STORAGE_ROOT=./storage/images
LOCAL_IMAGE_MAX_SIZE=10485760

# AI server
# AI_BASE_URL: BE(질문 생성 클라이언트)가 호출하는 AI 서버 주소 — S15P11B209-320.
#   compose 배포에선 비워두면 내부망 기본값 http://ai:8000 이 적용된다(따로 채울 필요 없음).
#   BE를 IDE에서 직접 돌리는 로컬 개발일 때만 http://localhost:8000 으로 지정.
# AI_BASE_URL=http://localhost:8000
# 그림 분석 클라이언트 — 기본 mock(HTTP 호출 안 함). 실서버 전환 시 http 로 변경.
# AI_DRAWING_ANALYSIS_MODE=mock
# AI_DRAWING_ANALYSIS_BASE_URL=http://ai:8000
# AI_DRAWING_ANALYSIS_ENDPOINT_PATH=/internal/v1/analyses
# HTTP mode 이미지 조회 URL — backend·ai가 공유하는 Docker 내부망 주소만 사용.
# AI_IMAGE_ACCESS_BASE_URL=http://backend:8080
# AI_IMAGE_ACCESS_TOKEN_TTL=60s
# AI_SERVER_URL은 코드에서 참조하지 않는 legacy 변수 — 정리 예정(위 AI_BASE_URL 사용).
AI_SERVER_URL=http://localhost:8000
AI_SERVER_PORT=8000
MODEL_PATH=
# BE↔AI 내부 계약(X-Internal-Token) 공유 토큰 — backend·ai 컨테이너 양쪽에 같은 값이 주입된다.
# 배포 필수: compose가 ${AI_INTERNAL_TOKEN:?}로 검증하고, ai 앱도 미설정 시 기동 실패(C-183-1).
# 생성 예: openssl rand -hex 32   (값은 .env/배포 시크릿에만 — 절대 커밋 금지)
AI_INTERNAL_TOKEN=
# 로컬 개발에서 토큰 없이 ai를 띄우려면 아래를 명시적으로 켠다(로컬 전용 — 배포에선 절대 금지).
# AI_INTERNAL_AUTH_DISABLED=true

# GMS (SSAFY OpenAI 호환 게이트웨이) — 대화 LLM / STT / TTS 공용
# 키는 절대 커밋하지 말 것(.env만, 로그 금지). BASE_URL은 GMS 프록시.
GMS_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=fable

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# Object storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
