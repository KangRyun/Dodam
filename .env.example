# Copy this file to .env and fill in local values.
# Never commit the real .env file.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=b209
DB_USERNAME=
DB_PASSWORD=

# MySQL container init (used by compose to bootstrap the mysql service)
# Keep in sync with the Database block above:
#   MYSQL_DATABASE = DB_NAME, MYSQL_USER = DB_USERNAME, MYSQL_PASSWORD = DB_PASSWORD
# MYSQL_ROOT_PASSWORD is admin-only and MUST differ from the app user's password.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Backend
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
JWT_SECRET=

# AI server
AI_SERVER_URL=http://localhost:8000
AI_SERVER_PORT=8000
MODEL_PATH=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# Object storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

